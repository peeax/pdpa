{
  "name": "pdpa",
  "version": "1.0.0",
  "description": "Thai PDPA Website (unofficial) — Next.js",
  "private": true,
  "scripts": {
    "gen": "node scripts/gen-public.mjs",
    "lint": "node scripts/lint-source.mjs",
    "test": "node scripts/check-production.mjs",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "check": "npm run lint && npm run test && npm run audit && npm run build",
    "watch:content": "nodemon --watch content --ext md,json --exec \"npm run gen\"",
    "predev": "node scripts/gen-public.mjs",
    "dev": "concurrently \"npm run watch:content\" \"next dev\"",
    "prebuild": "node scripts/gen-public.mjs",
    "build": "next build",
    "start": "node scripts/serve-static.mjs"
  },
  "author": "Siriraj Informatics and Data Innovation Center (SiData+)",
  "license": "MIT",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@theme-ui/mdx": "^0.17.4",
    "@tippyjs/react": "^4.2.6",
    "gray-matter": "^4.0.3",
    "lodash.isequal": "^4.5.0",
    "lodash.throttle": "^4.1.1",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "theme-ui": "^0.16.2",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
